{
    "name": "@kinnet-studio/split-flaps",
    "version": "0.1.0",
    "description": "Renderer-agnostic split-flap display engine with Canvas 2D and Pixi renderers",
    "keywords": [
        "split-flap",
        "solari",
        "departure-board",
        "flip-display",
        "animation",
        "canvas",
        "pixi"
    ],
    "author": "niuee",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kinnet-studio/split-flaps.git"
    },
    "homepage": "https://github.com/kinnet-studio/split-flaps#readme",
    "bugs": {
        "url": "https://github.com/kinnet-studio/split-flaps/issues"
    },
    "type": "module",
    "sideEffects": [
        "./src/**/*.ts"
    ],
    "files": [
        "dist"
    ],
    "main": "./dist/core/index.js",
    "types": "./dist/core/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/core/index.d.ts",
            "import": "./dist/core/index.js"
        },
        "./canvas": {
            "types": "./dist/canvas/index.d.ts",
            "import": "./dist/canvas/index.js"
        },
        "./pixi": {
            "types": "./dist/pixi/index.d.ts",
            "import": "./dist/pixi/index.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "prepublishOnly": "bun run typecheck && bun run test && bun run build",
        "build": "rm -rf dist && bun scripts/build.ts && tsc -p tsconfig.build.json && bun scripts/check-dist.ts",
        "dev": "vite --config examples/vite.config.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc -p tsconfig.json",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@ue-too/animate": "^0.19.0"
    },
    "peerDependencies": {
        "pixi.js": "^8.0.0"
    },
    "peerDependenciesMeta": {
        "pixi.js": {
            "optional": true
        }
    },
    "devDependencies": {
        "pixi.js": "8.20.1",
        "prettier": "3.8.1",
        "typescript": "^5.9.3",
        "vite": "^8.3.3",
        "vitest": "^5.0.3"
    }
}
