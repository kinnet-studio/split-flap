{
    "name": "@kinnet-studio/split-flap",
    "version": "0.3.0",
    "description": "Renderer-agnostic split-flap display engine with Canvas 2D and Pixi renderers",
    "keywords": [
        "split-flap",
        "solari",
        "departure-board",
        "flip-display",
        "animation",
        "canvas",
        "pixi"
    ],
    "author": "niuee",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kinnet-studio/split-flap.git"
    },
    "homepage": "https://github.com/kinnet-studio/split-flap#readme",
    "bugs": {
        "url": "https://github.com/kinnet-studio/split-flap/issues"
    },
    "type": "module",
    "sideEffects": [
        "./src/**/*.ts"
    ],
    "files": [
        "dist"
    ],
    "main": "./dist/core/index.js",
    "types": "./dist/core/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/core/index.d.ts",
            "import": "./dist/core/index.js"
        },
        "./canvas": {
            "types": "./dist/canvas/index.d.ts",
            "import": "./dist/canvas/index.js"
        },
        "./pixi": {
            "types": "./dist/pixi/index.d.ts",
            "import": "./dist/pixi/index.js"
        },
        "./sound": {
            "types": "./dist/sound/index.d.ts",
            "import": "./dist/sound/index.js"
        },
        "./react": {
            "types": "./dist/react/index.d.ts",
            "import": "./dist/react/index.js"
        },
        "./react-pixi": {
            "types": "./dist/react-pixi/index.d.ts",
            "import": "./dist/react-pixi/index.js"
        },
        "./vue": {
            "types": "./dist/vue/index.d.ts",
            "import": "./dist/vue/index.js"
        },
        "./vue-pixi": {
            "types": "./dist/vue-pixi/index.d.ts",
            "import": "./dist/vue-pixi/index.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "prepublishOnly": "bun run typecheck && bun run test && bun run build",
        "build": "rm -rf dist && bun scripts/build.ts && tsc -p tsconfig.build.json && bun scripts/check-dist.ts",
        "dev": "vite --config examples/vite.config.ts",
        "build:examples": "vite build --config examples/vite.config.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc -p tsconfig.json",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@ue-too/animate": "^0.19.0"
    },
    "peerDependencies": {
        "pixi.js": "^8.0.0",
        "react": ">=18",
        "vue": "^3.3"
    },
    "peerDependenciesMeta": {
        "pixi.js": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "vue": {
            "optional": true
        }
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vue/test-utils": "^2.5.1",
        "jsdom": "^30.1.2",
        "pixi.js": "8.20.1",
        "prettier": "3.8.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "typescript": "^5.9.3",
        "vite": "^8.3.3",
        "vitest": "^5.0.3",
        "vue": "^3.5.43"
    }
}
