{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "types": [],
        "paths": {
            "@kinnet-studio/split-flap": ["./src/core/index.ts"],
            "@kinnet-studio/split-flap/canvas": ["./src/canvas/index.ts"],
            "@kinnet-studio/split-flap/pixi": ["./src/pixi/index.ts"],
            "@kinnet-studio/split-flap/sound": ["./src/sound/index.ts"],
            "@kinnet-studio/split-flap/react": ["./src/react/index.ts"],
            "@kinnet-studio/split-flap/react-pixi": [
                "./src/react-pixi/index.ts"
            ],
            "@kinnet-studio/split-flap/vue": ["./src/vue/index.ts"],
            "@kinnet-studio/split-flap/vue-pixi": ["./src/vue-pixi/index.ts"]
        }
    },
    "include": ["src", "test", "examples"],
    "exclude": ["examples/vite.config.ts", "examples/dist"]
}
